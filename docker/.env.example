# Copie este arquivo para ".env" e preencha os valores antes de subir a stack

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha

# Evolution API
EVOLUTION_API_KEY=gere-uma-chave-forte-aqui
EVOLUTION_PUBLIC_URL=https://way.dfsconsulting.com.br

# N8N
N8N_HOST=way.dfsconsulting.com.br
N8N_PROTOCOL=https
N8N_PUBLIC_URL=https://way.dfsconsulting.com.br/
N8N_EDITOR_BASE_URL=https://way.dfsconsulting.com.br

N8N_USER=admin
N8N_PASSWORD=troque-esta-senha

# n8n Owner provisioning (optional)
# Password must be a bcrypt hash.
# Never put real credentials in this file.
N8N_INSTANCE_OWNER_MANAGED_BY_ENV=false
N8N_INSTANCE_OWNER_EMAIL=
N8N_INSTANCE_OWNER_FIRST_NAME=
N8N_INSTANCE_OWNER_LAST_NAME=
N8N_INSTANCE_OWNER_PASSWORD_HASH=

TZ=America/Sao_Paulo

# LLM (usada dentro dos workflows do N8N para interpretar as mensagens)
LLM_API_KEY=
