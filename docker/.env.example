# ============================================================
# DFS WAY
# Docker / n8n configuration
#
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA coloque o .env real no Git.
# ============================================================


# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha

# Banco utilizado pelo n8n.
# O banco será criado automaticamente pelo PostgreSQL
# na primeira inicialização.
N8N_DATABASE=n8n


# ------------------------------------------------------------
# n8n
# ------------------------------------------------------------

N8N_HOST=way.dfsconsulting.com.br
N8N_PROTOCOL=https

N8N_EDITOR_BASE_URL=https://way.dfsconsulting.com.br

N8N_PUBLIC_URL=https://way.dfsconsulting.com.br/


# ------------------------------------------------------------
# n8n authentication
# ------------------------------------------------------------

N8N_USER=admin
N8N_PASSWORD=troque-esta-senha


# ------------------------------------------------------------
# n8n owner provisioning
#
# Mantido desativado porque o usuário já foi criado
# normalmente pelo n8n.
# ------------------------------------------------------------

N8N_INSTANCE_OWNER_MANAGED_BY_ENV=false
N8N_INSTANCE_OWNER_EMAIL=
N8N_INSTANCE_OWNER_FIRST_NAME=
N8N_INSTANCE_OWNER_LAST_NAME=
N8N_INSTANCE_OWNER_PASSWORD_HASH=


# ------------------------------------------------------------
# LLM
# ------------------------------------------------------------

LLM_API_KEY=


# ------------------------------------------------------------
# Timezone
# ------------------------------------------------------------

TZ=America/Sao_Paulo